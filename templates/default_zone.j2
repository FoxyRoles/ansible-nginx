{{ ansible_managed | default('Ansible managed') | comment(prefix='', postfix='') | trim }}
server {
    listen       80 default_server;
    listen       [::]:80 default_server;
    server_name  {{ ansible_facts['hostname'] }};

    access_log   off;
    error_log    /dev/null crit;

    location / {
        root   /var/www/html;
        index  index.html;
    }
}
